node {

  try {
    env.CI_BUILD_TAG = env.BUILD_TAG.replaceAll('%2f','').replaceAll("[^A-Za-z0-9]+", "").toLowerCase()

    stage ('env') {
      sh "env"
    }

    stage ('Checkout') {
      def checkout = checkout scm
      env.GIT_COMMIT = checkout["GIT_COMMIT"]
    }

    stage ('env') {
      sh "env"
    }

    notifySlack()

    try {
      stage ('up') {
        sh "make ci.up"
      }
      stage ('persistgraphql') {
        sh "make ci.persistgraphql"
      }
      parallel (
        'lint': {
          stage ('lint') {
            sh "make ci.lint"
          }
        },
        'test': {
          stage ('test') {
            sh "make ci.test"
          }
        }
      )
      stage ('cleanup') {
        cleanup()
      }

    } catch (e) {
      echo "Something went wrong, trying to cleanup"
      cleanup()
      throw e
    }

  } catch (e) {
    currentBuild.result = 'FAILURE'
    throw e
  } finally {
    notifySlack(currentBuild.result)
  }

}

def cleanup() {
  try {
    sh "make ci.down"
  } catch (error) {
    echo "cleanup failed, ignoring this."
  }
}

def notifySlack(String buildStatus = 'STARTED') {
    // Build status of null means success.
    buildStatus = buildStatus ?: 'SUCCESS'

    def color

    if (buildStatus == 'STARTED') {
        color = '#68A1D1'
    } else if (buildStatus == 'SUCCESS') {
        color = '#BDFFC3'
    } else if (buildStatus == 'UNSTABLE') {
        color = '#FFFE89'
    } else {
        color = '#FF9FA1'
    }

    def msg = "${buildStatus}: `${env.JOB_NAME}` #${env.BUILD_NUMBER}:\n${env.BUILD_URL}"

    slackSend(color: color, message: msg, channel: 'ras-ci', teamDomain: 'amazee', token: 'xFWAhjdCiXO26K7KXMsBwGT4')
}
