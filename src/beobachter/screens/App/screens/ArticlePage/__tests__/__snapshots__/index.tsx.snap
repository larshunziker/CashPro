        class="article-header ArticleHeader"
      />
    </div>
    <div
      class="Wrapper"
    >
      <div
        class="article-body BodyWrapper"
      >
        <div
          data-testid="articlepage-paragraphs"
        />
      </div>
    </div>
  </div>
  <div
    class="Container"
  >
    <div
      class="Row"
    >
      <div
        class="ColXs24 ColSm22 ColMd17 ColXl14 ColOffsetSm1 ColOffsetMd1 ColOffsetXl5"
      >
        <section
          class="Wrapper GooglePreferredSource"
        >
          <button
            class="Button ClickEffect Secondary Small"
            tabindex="0"
            type="submit"
          >
            <span>
              <div
                class="Icon"
                type="icons/type/google-preferred-source"
              />
              <span
                class="Content"
              >
                Bevorzugte Quelle
              </span>
            </span>
          </button>
          <button
            class="Button ClickEffect Tertiary Small"
            tabindex="0"
          >
            <span>
              <span
                class="Content"
              >
                So funktioniert's
              </span>
            </span>
          </button>
        </section>
      </div>
    </div>
  </div>
  <div
    data-testid="smooth-scroll-factory-wrapper"
    id="comments"
  />
  <div
    class="ad-wrapper ad-wrapper-mobile"
  >
    <div
      class="AdSlot MHPA2"
      data-device-type="mobile"
      data-slot-name="MHPA_2"
      data-testid="app-nexus-wrapper"
      id="apn-ad-slot-mhpa-2-1-mobile"
    />
  </div>
</div>
`;

