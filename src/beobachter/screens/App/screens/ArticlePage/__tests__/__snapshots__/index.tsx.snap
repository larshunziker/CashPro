exports[`[Component] ArticlePage Should correctly render guide article type, with navigation and button to top 1`] = `
<div>
  <div
    class="article-guide-detail"
    data-testid="articlepage-guide-wrapper"
    id="article-body-undefined"
  >
    <div
      data-testid="smooth-scroll-factory-wrapper"
      id="smoothScrollToTop"
    />
    <div
      class="Container"
    >
      <div
        class="Row"
      >
        <div
          class="ColXs24 ColMd7 ColXl6 HiddenMdDown HideForPrint"
        >
          <div
            data-testid="table-of-contents-wrapper"
          />
        </div>
        <div
          class="ColXs24 ColMd17 ColXl16 ColOffsetXl2"
        >
          <div
            class="Row"
          >
            <div
              class="ColXs24 ColSm20 ColOffsetSm2 ColOffsetMd0 ColMd24 ColXl21"
            >
              <div
                data-testid="article-head-default-wrapper"
              >
                <div
                  class="AuthorWrapper AuthorWrapperMargin DateWrapper"
                  data-testid="main-container"
                >
                  <div>
                    <div
                      data-testid="author-container"
                    >
                      <span
                        class="Author"
                      >
                        <div
                          class="AuthorLink InActiveLink"
                          data-testid="empty-link"
                        >
                          <span
                            itemprop="author"
                          >
                            Mocked Author
                          </span>
                        </div>
                      </span>
                      <span
                        class="Author"
                      >
                        , 
                        <a
                          class="AuthorLink ActiveLink"
                          data-testid="routed-link"
                          href="/unsere-redaktion/tina-steinauer"
                        >
                          <span
                            itemprop="author"
                          >
                            Tina Steinauer
                          </span>
                        </a>
                      </span>
                      <span
                        class="Author"
                      >
                         und 
                        <a
                          class="AuthorLink ActiveLink"
                          data-testid="routed-link"
                          href="/unsere-redaktion/test-author"
                        >
                          <span
                            itemprop="author"
                          >
                            Test Author
                          </span>
                        </a>
                      </span>
                    </div>
                    <span
                      class="Dates"
                      data-testid="dates-wrapper"
                    >
                      <br />
                      <span
                        class="PublicationDate"
                        data-testid="publication-date-wrapper"
                      >
                        <span
                          data-testid="publication-date-label"
                        >
                          Veröffentlicht 
                        </span>
                        am 6. Januar 2021 - 08:32 Uhr
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="ColXs24 HiddenMdUp HideForPrint"
            >
              <div
                data-testid="table-of-contents-wrapper"
              />
            </div>
          </div>
          <div
            data-testid="articlepage-paragraphs"
          >
            <div
              class="Row"
            >
              <div
                class="ColXs24"
              >
                <div
                  class="ParagraphsRendererContainer"
                  data-testid="paragraphsrenderer-container"
                >
                  <div
                    class=""
                  >
                    <div
                      id="179229"
                    >
                      <div
                        class="Section SectionTextParagraph"
                      >
                        <div
                          class="Paragraphs ContainerInner"
                        >
                          <div
                            class="Row"
                            data-testid="paragraph-item"
                          >
                            <div
                              class="ColXs24 ColSm20 ColOffsetSm2 ColOffsetMd0 ColMd24 ColXl21"
                            >
                              <div
                                data-testid="paragraphsrenderer-text-paragraph-wrapper"
                                id="articleheader"
                              >
                                <div
                                  class="paragraph text-paragraph RichTextWrapper"
                                  data-testid="textparagraph-outer-div"
                                >
                                  <div
                                    class="Header"
                                    data-testid="textparagraph-header"
                                  >
                                    article header
                                  </div>
                                  <div
                                    data-testid="textparagraph-text"
                                  >
                                    <p>
                                      Für die diesjährige Welt-Aids-Konferenz reisen Menschen aus 160 Ländern nach Amsterdam. Darunter auch viele prominente Unterstützer. 
                                      <strong>
                                        Unter anderem Prinz Harry, 33, der ohne seine Meghan Markle, 36, anreiste, und Sänger Elton John, 71.
                                      </strong>
                                    </p>
                                    


                                    <p>
                                      Prinz Harry hat einen starken Bezug zum Kampf gegen die Autoimmunkrankheit. 
                                      <strong>
                                        Seine verstorbene Mutter, †36, setzte sich einst für Aidskranke ein und brach viele Tabus im Umgang mit Infizierten. 
                                      </strong>
                                      Prinzessin Diana 
                                      <span
                                        style="font-size: 1em;"
                                      >
                                        erkannte die Problematik um die Berührungsängste als eine der Ersten und setzte ein Zeichen. 
                                        <strong>
                                          Im Jahr 1987 schüttelte sie ungeniert (ganz ohne Handschuhe) die Hände von Aidspatienten.
                                        </strong>
                                         Die Fotos aus dem Spital gingen um die Welt.
                                      </span>
                                    </p>
                                    

                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="ButtonWrapper ScrollToTopFadeOut"
      >
        <a
          aria-label="Nach oben"
          class="ButtonToTop"
          href="#smoothScrollToTop"
        >
          <i
            class="Icon IconChevronUp IconStyles"
          />
        </a>
      </div>
    </div>
  </div>
</div>
`;

