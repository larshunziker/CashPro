       url('../fonts/SpeziaWeb-Regular.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Spezia';
  font-weight: 400;
  src: url('../fonts/SpeziaWeb-Regular.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/SpeziaWeb-Regular.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Spezia';
  font-weight: 700;
  src: url('../fonts/SpeziaWeb-Bold.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/SpeziaWeb-Bold.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Spezia';
  font-weight: 900;
  src: url('../fonts/SpeziaWeb-Bold.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/SpeziaWeb-Bold.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Recife';
  src: local('Recife'),
       local('Recife Web'),
       url('../fonts/RecifeTextWeb-Regular.woff2') format('woff2'),
       url('../fonts/RecifeTextWeb-Regular.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: fallback;
}

@font-face {
    font-family: 'Recife';
    src: local('Recife'),
        local('Recife Web'),
        url('../fonts/RecifeTextWeb-Bold.woff2') format('woff2'),
        url('../fonts/RecifeTextWeb-Bold.woff') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: fallback;
}
