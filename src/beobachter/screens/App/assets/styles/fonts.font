@font-face {
  font-family: 'rasch-font';
  src:  url('../../../../../common/assets/fonts/RASCH-Font.woff2?24u0vb') format('woff2'),
        url('../../../../../common/assets/fonts/RASCH-Font.woff?24u0vb') format('woff'),
        url('../../../../../common/assets/fonts/RASCH-Font.svg?24u0vb#RASCH-Font') format('svg');
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: 'Gotham-Narrow';
  font-weight: 100;
  src: url('../fonts/GothamNarrow-Light.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/GothamNarrow-Light.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Gotham-Narrow';
  font-weight: 200;
  src: url('../fonts/GothamNarrow-Book.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/GothamNarrow-Book.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Gotham-Narrow';
  font-weight: 400;
  src: url('../fonts/GothamNarrow-Medium.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/GothamNarrow-Medium.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Gotham-Narrow';
  font-weight: 700;
  src: url('../fonts/GothamNarrow-Bold.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/GothamNarrow-Bold.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Gotham-Narrow';
  font-weight: 900;
  src: url('../fonts/GothamNarrow-Black.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/GothamNarrow-Black.woff') format('woff'); /* Pretty Modern Browsers */  
  font-display: swap; 
}

@font-face {
  font-family: 'Algebra';
  src: local('Algebra'),
       local('Algebra Web'),
       url('../fonts/Algebra-optimized/subset-Algebra-Regular.woff2') format('woff2'),
       url('../fonts/Algebra-optimized/subset-Algebra-Regular.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: fallback;
}

@font-face {
    font-family: 'Algebra';
    src: local('Algebra'),
        local('Algebra Web'),
        url('../fonts/Algebra-optimized/subset-Algebra-Bold.woff2') format('woff2'),
        url('../fonts/Algebra-optimized/subset-Algebra-Bold.woff') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: fallback;
}

@font-face {
  font-family: 'Spezia';
  font-weight: 100;
  src: url('../fonts/SpeziaWeb-Regular.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/SpeziaWeb-Regular.woff') format('woff'); /* Pretty Modern Browsers */
  font-display: swap;
}

@font-face {
  font-family: 'Spezia';
  font-weight: 200;
