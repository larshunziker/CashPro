# search screen
if ($args ~ "search=(.*)") {
  set $search $1;
  rewrite ^/suche?$ https://$host/suche/$search? permanent;
}

# stichwortseiten
rewrite ^/stichwortverzeichnis/stichwort/([^/])([^/]+)/?$ https://$host/stichworte/$1/$1$2 permanent;
rewrite ^/stichworte/stichwortbuchstabe/([^/])/?$ https://$host/stichworte/$1 permanent;
rewrite ^/stichworte/$ https://$host/stichworte permanent;

# Ads.txt
rewrite ^/ads.txt https://adm-adstxt.s3.eu-central-1.amazonaws.com/beobachter_ch/ads.txt permanent;

# epaper
rewrite ^/archiv/$ https://$host/epaper permanent;

# home
rewrite ^/themen/?$ https://$host/ permanent;
rewrite ^/aktuell/?$ https://$host/ permanent;
rewrite ^/home/?$ https://$host/ permanent;

# forum alt
rewrite ^/forum$ https://$host permanent;
rewrite ^/foren$ https://$host permanent;
rewrite ^/foren/(.*)$ https://$host permanent;

