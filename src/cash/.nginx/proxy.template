map $arg_f $sitemap {
    default   "index";
    "~.+"     "$arg_f";
}


map $host $forumEnv {
   default "https://forum.stage.cash.ch";
  "master.cash.ch" "https://forum.cash.ch";
  "www.cash.ch" "https://forum.cash.ch";
}


server {
    listen 8080;

    server_name _;

    resolver 8.8.8.8 valid=30s;

    # Calling the Drupal backend using cms.ringiermedienschweiz.ch goes through
    # Akamai, which can lead to timeouts since the feeds may take a while to
    # generate. Using the internal URL prevents this.
    set $drupal_backend "https://nginx.prod.rasch-backend-k8s-prod.prod.ras.dev:443";

    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 64 16k;
    proxy_busy_buffers_size 256k;

    port_in_redirect off;

    # Disable compression
    gzip off;

    # Proxy settings
    set $xPublication "cash";
    include /etc/nginx/conf.d/proxy.services;

    # Redirects
    include /etc/nginx/conf.d/proxy.redirects;

    location /pageview.txt {
      alias /etc/nginx/conf.d/pageview.txt;
    }

    location /robots.txt {
      alias /etc/nginx/conf.d/robots.txt;
    }

    location ~ ^/xml/ {
      return 404;
    }
    location ~ ^/wp-login.php {
      return 404;
    }
    # block requests for Drupal sources on SSR
    location ~ ^/sites/all/ {
      return 404;
    }
    location ~ ^/sites/default/files/(styles|css|js)/ {
      return 404;
    }
    location ~ ^/style/sites/default/files/(styles|css|js)/ {
      return 404;
    }
    location ~ ^/system/acquia-connector-status {
      return 404;
    }
    location ~ ^/feeds/google_newsstand_7319e0c37ec146827606ecdf9d0bc9ad/3275 {
      return 404;
    }
    location ~ ^/jstats.php$ {
      return 404;
    }

    # News Sitemaps
    location /sitemap-news.xml {
      proxy_pass https://cde.hexagon.build/feeds/ZDpgY3?token=ab06a1a3-7aa7-4a8e-978e-4d2007827ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    # RSS article
    location /rss-article.xml {
      proxy_pass https://cde.hexagon.build/feeds/zDb86y?token=ab06a1a3-7aa7-4a8e-978e-4d2001718ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    # Time-limited sitemaps
    location ~ ^/sitemap-articles-time-limited(.*) {
      proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-1663/sitemap-articles-time-limited$1;
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }

    # Sitemaps
    location ~ ^/sitemap.xml$ {
      proxy_pass "$drupal_backend/sites/default/files/sitemap/general/cash/$sitemap.xml";
      proxy_set_header Host $proxy_host;
      proxy_http_version 1.1;
    }

    # News Showcase
    location  /google-news-showcase.xml {
      proxy_pass https://cde.hexagon.build/feeds/DpYKOm?token=ab06a1a3-7aa7-4a8e-978e-4d2001718ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    # Image sitemaps
    location ~ ^/image-sitemap.xml$ {
      proxy_pass "$drupal_backend/sites/default/files/sitemap/image/cash/$sitemap.xml";
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }

    # Author sitemaps
    location ~ ^/sitemap-authors.xml$ {
      proxy_pass "$drupal_backend/sites/default/files/sitemap/author/cash/author-sitemap.xml";
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }

    # Evergreen sitemaps
    location ~ ^/sitemap-articles-evergreen(.*) {
      proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2041/sitemap-articles-evergreen$1;
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }

    # Category sitemaps
    location /sitemap-category.xml {
      proxy_pass https://cde.hexagon.build/feeds/73PPq3?token=ab06a1a3-7aa7-4a8e-978e-4d2007827ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    # Google valor sitemap
    location ~ ^/valor-sitemap.xml$ {
      proxy_pass "$drupal_backend/sites/default/files/sitemap/valor/cash/$sitemap.xml";
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }

    location ~* \.(eot|otf|ttf|woff|woff2)$ {
      add_header Access-Control-Allow-Origin *;

      proxy_pass ${NGINX_PROXY_PASS};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
    }

    # RSS feed Articles (legacy URL)
    location = /newest-content-feed/all/all {
      return 301 https://$host/rss-article.xml;
    }
    # RSS feed News (new URL)
    location ~ ^/feeds/latest/news$ {
      rewrite ^/feeds/latest/news$ /feeds/latest/18/147768? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # RSS feed Top-News (legacy URL)
    location ~ ^/rss/771.xml$ {
      rewrite ^/rss/771.xml$ /feeds/latest/18/147775? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }
    # RSS feed Top-News (new URL)
    location ~ ^/feeds/latest/top-news$ {
      rewrite ^/feeds/latest/top-news$ /feeds/latest/18/147775? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # RSS feed Stock markets (legacy URL)
    location ~ ^/rss/450.xml$ {
      rewrite ^/rss/450.xml$ /feeds/latest/18/147778? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }
    # RSS feed Stock markets (new URL)
    location ~ ^/feeds/latest/borsen-ticker$ {
      rewrite ^/feeds/latest/borsen-ticker$ /feeds/latest/18/147778? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # RSS feed Social
    location ~ ^/newest-content-feed/fb-li$ {
      rewrite ^/newest-content-feed/fb-li$ /feeds/social/18? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # RSS feed Crypto (legacy URL)
    location ~ ^/feed-cryptocurrencies$ {
      rewrite ^/feed-cryptocurrencies$ /feeds/cryptocurrencies/18? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # RSS feed UBS Invest (legacy URL)
    location ~ ^/feed-ubs-invest$ {
      rewrite ^/feed-ubs-invest$ /feeds/rss_na_by_channel_sponsor/18/147810/371267? break;
      proxy_set_header X-RAS-PUBLICATION 'api.cash.ch';
      proxy_set_header Host $proxy_host;
      proxy_pass $drupal_backend;
      proxy_http_version 1.1;
    }

    # Handle paths starting with /rss after RSS rewrites
    location ~ ^/rss/ {
      return 404;
    }

    location / {
      proxy_pass ${NGINX_PROXY_PASS};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
    }
}
