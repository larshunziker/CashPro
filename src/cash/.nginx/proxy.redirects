# search screen
if ($args ~ "search=(.*)") {
  set $search $1;
  rewrite ^/suche/alle?$ https://$host/suche/alle/$search? permanent;
}

# Ads.txt
rewrite ^/ads.txt https://adm-adstxt.s3.eu-central-1.amazonaws.com/cash_ch/ads.txt permanent;

# redirect /monitor to full quote page
rewrite ^/(.*?)?(/monitor$)+?$ "https://$host/$1" permanent;

# redirect /portfolio/konto/xyzasd to /portfolio/xyzasd/konto
rewrite ^/portfolio/konto/+(.*)?$ "https://$host/portfolio/$1/konto" permanent;

# redirect forum
rewrite ^/forum$ $forumEnv permanent;
rewrite ^/forum/(.*) $forumEnv/forum/$1 permanent;

# rss feed redirects
rewrite ^/rss/771.xml https://$host/feeds/latest/top-news permanent;
rewrite ^/rss/448.xml https://$host/feeds/latest/news permanent;
rewrite ^/feeds/news/alle https://$host/feeds/latest/news permanent;
rewrite ^/feeds/news/boersenticker https://$host/feeds/latest/borsen-ticker permanent;
