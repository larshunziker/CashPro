@define-mixin fontSize $size {
  font-size: calc($size * 0.0625rem);
}

@define-mixin lineHeight $size {
  line-height: calc($size * 0.0625rem);
}

@define-mixin H1 {
  color: $blackB;
  font-family: $fontSourceSerifPro;
  @mixin fontSize 25;
  font-weight: bold;
  @mixin lineHeight 29;

  @media (min-width: $smBreakpoint) {
    @mixin fontSize 40;
    @mixin lineHeight 48;
  }

  @media (min-width: $xlBreakpoint) {
    @mixin fontSize 50;
    @mixin lineHeight 55;
  }
}

@define-mixin H2 {
  color: $blackB;
  font-family: $fontSourceSerifPro;
  @mixin fontSize 21;
  font-weight: bold;
  @mixin lineHeight 25;

  @media (min-width: $smBreakpoint) {
    @mixin fontSize 28;
    @mixin lineHeight 32;
  }

  @media (min-width: $xlBreakpoint) {
    @mixin fontSize 35;
    @mixin lineHeight 35;
  }
}

@define-mixin H3 {
  color: $blackB;
  font-family: $fontSourceSerifPro;
  @mixin fontSize 19;
  font-weight: bold;
