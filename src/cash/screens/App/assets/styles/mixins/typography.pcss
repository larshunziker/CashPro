@define-mixin Widget {
  color: $blackB;
  font-family: $fontSourceSansPro;
  @mixin fontSize 14;
  font-weight: normal;
  @mixin lineHeight 18;

  @media (min-width: $smBreakpoint) {
    @mixin fontSize 18;
    @mixin lineHeight 23;
  }
  @media (min-width: $mdBreakpoint) {
    @mixin fontSize 14;
    @mixin lineHeight 18;
  }

  @media (min-width: $xlBreakpoint) {
    @mixin fontSize 18;
    @mixin lineHeight 23;
  }
}

@define-mixin WidgetBold {
  @mixin Widget;
  font-weight: bold;
}

@define-mixin RaschIconFiles {
  display: inline;
  font-family: $fontRasch;
  margin-right: 1px;
  vertical-align: top;
}

/* Not from styleguide */
@define-mixin AdCaption {
  color: $greyA;
  font-size: 1.1rem;
  font-weight: 200;
  letter-spacing: 0.1px;
  text-transform: uppercase;
}

@define-mixin RichTextLink {
  color: $secondaryA;
  padding: 1px;

  &:hover {
    color: $secondaryB;
  }

  &:not([href*='cash.ch']) {
    &:not([href^='#']) {
      &:not([href^='/']) {
        &:not([href^='mailto:']) {
          &:not([href^='tel:']) {
            &:not([class*='teaser']) {
              &:not([class*='utility-button']) {
                &:not([class*='Icon']) {
                  &::after {
                    @mixin RaschIconFiles;
                    content: '\e924';
                    margin-left: 3px;
                  }

                  &:not([href*='.pdf']) {
                    &::after {
                      @mixin RaschIconFiles;
                      content: '\e921';
                      margin-left: 3px;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  @media print {
    color: $blackB;
  }
}
