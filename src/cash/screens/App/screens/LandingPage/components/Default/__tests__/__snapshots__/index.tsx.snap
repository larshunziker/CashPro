            data-track-info="[{"type":"data-utility-button-type","value":"utility bar"},{"type":"data-utility-button-target","value":"Teilen"}]"
            target="_self"
          >
            <div
              class="Wrapper Icon"
              type="svg-icons/type/share"
            />
