            />
            <p
              class="Label"
            >
              Rechner
            </p>
          </div>
        </div>
        <div
          data-testid="utility-link-wrapper"
        >
          <div
            aria-label="Link zu Download"
            class="utility-button Link"
            data-testid="empty-link"
            data-track-info="[{"type":"data-utility-button-type","value":"utility bar"},{"type":"data-utility-button-target","value":"Download"}]"
            target="_self"
          >
            <div
              class="Wrapper Icon"
              type="svg-icons/type/download"
            />
            <p
              class="Label"
            >
              Download
            </p>
          </div>
        </div>
        <div
          data-testid="utility-link-wrapper"
        >
          <a
            aria-label="Link zu FAQ/Hilfe"
            class="utility-button Link"
            data-testid="routed-link"
            data-track-info="[{"type":"data-utility-button-type","value":"utility bar"},{"type":"data-utility-button-target","value":"FAQ/Hilfe"}]"
            href="/anlegen/faq"
