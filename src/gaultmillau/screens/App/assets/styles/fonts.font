@font-face {
  font-family: 'gault-millau';
  src:  url('../fonts/gault-millau.woff2?kdhtug') format('woff2'),
        url('../fonts/gault-millau.woff?kdhtug') format('woff'),
        url('../fonts/gault-millau.svg?kdhtug#gault-millau') format('svg');
  font-weight: normal;
  font-style: normal;
}

