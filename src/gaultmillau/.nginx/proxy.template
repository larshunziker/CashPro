map $arg_f $sitemap {
    default   "index";
    "~.+"     "$arg_f";
}

map "$host:$arg_utm_medium" $redirectPreview {
    ~^preview.*:email$  1;
    default             0;
}

server {
  listen 8080;

  server_name _;

  resolver 8.8.8.8 valid=30s;

  # Calling the Drupal backend using cms.ringiermedienschweiz.ch goes through
  # Akamai, which can lead to timeouts since the feeds may take a while to
  # generate. Using the internal URL prevents this.
  set $drupal_backend "https://nginx.prod.rasch-backend-k8s-prod.prod.ras.dev:443";

  proxy_buffering on;
  proxy_buffer_size 128k;
  proxy_buffers 64 16k;
  proxy_busy_buffers_size 256k;

  port_in_redirect off;

  # Disable compression
  gzip off;

  # Proxy settings
  set $xPublication "gaultmillau";
  include /etc/nginx/conf.d/proxy.services;

  # Redirects
  include /etc/nginx/conf.d/proxy.redirects;

  location /pageview.txt {
    alias /etc/nginx/conf.d/pageview.txt;
  }
  location /robots.txt {
    alias /etc/nginx/conf.d/robots.txt;
  }

  # Sitemaps
  location ~ ^/sitemap.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/general/gault_millau/$sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Sitemaps FR
  location ~ ^/fr/sitemap.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/general/gault_millau_fr/$sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # News Sitemaps
  location /sitemap-news.xml {
    proxy_pass https://cde.hexagon.build/feeds/3G2jNy?token=ab06a1a3-7aa7-4a8e-978e-4d2007827ef5;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }

  # News Sitemaps FR
  location /fr/sitemap-news.xml {
    proxy_pass https://cde.hexagon.build/feeds/DOjKE3?token=ab06a1a3-7aa7-4a8e-978e-4d2007827ef5;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }

  # Image sitemaps
  location ~ ^/image-sitemap.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/image/gault_millau/$sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Image sitemaps FR
  location ~ ^/fr/image-sitemap.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/image/gault_millau_fr/$sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Author sitemaps
  location ~ ^/sitemap-authors.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/author/gault_millau/author-sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Author sitemaps FR
  location ~ ^/fr/sitemap-authors.xml$ {
    proxy_pass "$drupal_backend/sites/default/files/sitemap/author/gault_millau_fr/author-sitemap.xml";
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Time-limited sitemaps FR
  location ~ ^/fr/sitemap-articles-time-limited(.*) {
    proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2067/sitemap-articles-time-limited-fr$1;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }
  location ~ ^/sitemap-articles-time-limited-fr(.*) {
    proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2067/sitemap-articles-time-limited-fr$1;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Time-limited sitemaps
  location ~ ^/sitemap-articles-time-limited(.*) {
    proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2037/sitemap-articles-time-limited$1;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }

  # Flipboard feed all contents
  location ~ ^/feeds/flipboard/all$ {
    rewrite ^/feeds/flipboard/all$ /feeds/flipboard/1/all? break;
    proxy_set_header X-RAS-PUBLICATION 'api.gaultmillau.ch';
    proxy_set_header Host $proxy_host;
    proxy_pass $drupal_backend;
    proxy_http_version 1.1;
    }

  # Flipboard feed Züri isst
  location ~ ^/feeds/flipboard/zuri-isst$ {
    rewrite ^/feeds/flipboard/zuri-isst$ /feeds/flipboard/1/1500? break;
    proxy_set_header X-RAS-PUBLICATION 'api.gaultmillau.ch';
    proxy_set_header Host $proxy_host;
    proxy_pass $drupal_backend;
    proxy_http_version 1.1;
  }

  # RSS feed
  location ~ ^/rss_feed$ {
    rewrite ^/rss_feed$ /feeds/rss/1? break;
    proxy_set_header X-RAS-PUBLICATION 'api.gaultmillau.ch';
    proxy_set_header Host $proxy_host;
    proxy_pass $drupal_backend;
    proxy_http_version 1.1;
  }

  location ~ ^/rss_feed_fr$ {
    rewrite ^/rss_feed_fr$ /feeds/rss/6? break;
    proxy_set_header X-RAS-PUBLICATION 'api.gaultmillau.ch';
    proxy_set_header Host $proxy_host;
    proxy_pass $drupal_backend;
    proxy_http_version 1.1;
  }

  location ~* \.(eot|otf|ttf|woff|woff2)$ {
    add_header Access-Control-Allow-Origin *;

    proxy_pass ${NGINX_PROXY_PASS};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;    
  }

  location / {


    #redirect rule for preview links in newsletter
    if ($redirectPreview) {
      rewrite ^/(.*) https://www.gaultmillau.ch/$1 permanent;
    }

    proxy_pass ${NGINX_PROXY_PASS};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }
}
