    location ~* \.(eot|otf|ttf|woff|woff2)$ {
      add_header Access-Control-Allow-Origin *;

      proxy_pass ${NGINX_PROXY_PASS};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # hybrid app menu no-cache
    location ~ ^/hybrid/menu.json$ {
      expires -1;
      proxy_no_cache 1;
      proxy_cache_bypass $http_upgrade;

      proxy_pass ${NGINX_PROXY_PASS};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

        # News Showcase
    location  /google-news-showcase.xml {
      proxy_pass https://cde.hexagon.build/feeds/dDMZom?token=ab06a1a3-7aa7-4a8e-978e-4d2001718ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    location / {


      #redirect rule for preview links in newsletter
      if ($redirectPreview) {
        rewrite ^/(.*) https://www.handelszeitung.ch/$1 permanent;
      }

      # proxying for presto amp pages
      location ~ ^(/.*?)\/amp$ {
        resolver 8.8.8.8;
        proxy_set_header X-Akamai 66b92b30e83141ee1016740652f256ec1e006118df6ecb5ca4ffab9384942226;
        proxy_pass $ampEnv$1/amp/;
      }

      # proxying for presto amp assets and static resources
      location ~ ^/amp-assets(\/.*)$ {
        proxy_set_header X-Akamai 66b92b30e83141ee1016740652f256ec1e006118df6ecb5ca4ffab9384942226;
        proxy_pass $ampEnv/amp-assets$1;
      }

      proxy_pass ${NGINX_PROXY_PASS};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }
