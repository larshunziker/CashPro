include /etc/nginx/conf.d/proxy.redirects-bil-map;

map $arg_f $sitemap {
    default   "index";
    "~.+"     "$arg_f";
}

map "$host:$arg_utm_medium" $redirectPreview {
    ~^preview.*:email$  1;
    default             0;
}

map $host $ampEnv {
   default "https://d2zlz13f0o344k.cloudfront.net"; # amp.handelszeitung.ch
  "develop.handelszeitung.ch" "https://d3ucnh9z4fd9r3.cloudfront.net"; # amp.develop.handelszeitung.ch
  "stage.handelszeitung.ch" "https://d2crr6uidpsvdj.cloudfront.net"; # amp.stage.handelszeitung.ch
}

server {
    listen 8080;

    server_name _;

    resolver 8.8.8.8 valid=30s;

    # Calling the Drupal backend using cms.ringiermedienschweiz.ch goes through
    # Akamai, which can lead to timeouts since the feeds may take a while to
    # generate. Using the internal URL prevents this.
    set $drupal_backend "https://nginx.prod.rasch-backend-k8s-prod.prod.ras.dev:443";

    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 64 16k;
    proxy_busy_buffers_size 256k;
    proxy_cache off;

    port_in_redirect off;

    # Disable compression
    gzip off;

    # Proxy settings
    set $xPublication "handelszeitung";
    include /etc/nginx/conf.d/proxy.services;

    # Redirects
    include /etc/nginx/conf.d/proxy.redirects;

    location /pageview.txt {
      alias /etc/nginx/conf.d/pageview.txt;
    }
    location /robots.txt {
      alias "/etc/nginx/conf.d/robots-handelszeitung.txt";
    }
    location ~ ^/xml/ {
      return 404;
    }
    location ~ ^/rss/ {
      return 404;
    }
    location ~ ^/wp-login.php {
      return 404;
    }

    # News Sitemaps
    location /sitemap-news.xml {
      proxy_pass https://cde.hexagon.build/feeds/M3E8My?token=ab06a1a3-7aa7-4a8e-978e-4d2007827ef5;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host $proxy_host;
    }

    # BIL Evergreen sitemaps
    location ~ ^/bilanz/sitemap-articles-evergreen(.*) {
      proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2062/sitemap-articles-evergreen-bilanz$1;
      proxy_http_version 1.1;
      proxy_set_header Host $proxy_host;
    }
    location ~ ^/sitemap-articles-evergreen-bilanz(.*) {
      proxy_pass https://cde-sitemaps-production.s3.eu-west-1.amazonaws.com/feed-2062/sitemap-articles-evergreen-bilanz$1;
