    line-height: 4.7rem;
  }
}

@define-mixin CatchQuestionsSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.2rem;
  font-style: normal;
  font-variant-numeric: lining-nums proportional-nums;
  font-weight: 900;
  letter-spacing: 1px;
  line-height: 2rem;
  text-transform: uppercase;

  @media (min-width: $smBreakpoint) {
    font-size: 1.5rem;
    line-height: 3.2rem;
  }
}

@define-mixin ParagraphSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.8rem;
  font-style: normal;
  font-weight: 300;
  line-height: 2.5rem;

  @media (min-width: $smBreakpoint) {
    font-size: 2rem;
    line-height: 3.3rem;
  }
}

@define-mixin Paragraph2SY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 300;
  line-height: 2rem;

  @media (min-width: $xlBreakpoint) {
    font-size: 1.9rem;
    line-height: 3.2rem;
  }
}

@define-mixin ParagraphBoldSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 700;
  line-height: 2rem;

  @media (min-width: $smBreakpoint) {
    font-size: 1.9rem;
    line-height: 3.2rem;
  }
}

@define-mixin CaptionAuthorParagraphSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: 0.5px;
  line-height: 1.2rem;
}

@define-mixin CaptionAuthorCopyRightSY {
  color: $grayB;
  font-family: $fontBague;
  font-size: 1rem;
  font-style: italic;
  font-weight: 400;
  letter-spacing: 0.5px;
  line-height: 1.2rem;
}

@define-mixin CaptionTitleAuthorParagraphSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.2rem;
  font-style: normal;
  font-weight: 900;
  letter-spacing: 0.5px;
  line-height: 1.2rem;
}

@define-mixin BreadcrumbsWordsSY {
  color: $grayC;
  font-family: $fontBague;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  line-height: 1.3rem;
}

@define-mixin BreadcrumbsSymbolSY {
  color: $grayC;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 400;
  line-height: 1.5rem;
}

@define-mixin QuoteSY {
  color: $black;
  font-family: $fontLeJeune;
  font-size: 2.4rem;
  font-stretch: normal;
  font-style: normal;
  font-weight: 500;
  line-height: 2.8rem;

  @media (min-width: $smBreakpoint) {
    font-size: 2.7rem;
    line-height: 3.3rem;
  }
}

@define-mixin QuoteAuthorSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1rem;
  font-style: normal;
  font-variant-numeric: lining-nums proportional-nums;
  font-weight: 400;
  letter-spacing: 3px;
  line-height: 1.2rem;
  text-transform: uppercase;

  @media (min-width: $smBreakpoint) {
    font-size: 1.2rem;
    letter-spacing: 4px;
    line-height: 1.5px;
  }

  @media (min-width: $xlBreakpoint) {
    font-size: 1.4rem;
    letter-spacing: 5px;
    line-height: 1.8rem;
  }
}

@define-mixin TagBanderoleSY {
  color: $black;
  font-family: $fontBague;
  font-size: 1.2rem;
  font-style: italic;
  font-weight: 700;
  letter-spacing: 0.5px;
  line-height: 2rem;

  @media (min-width: $xlBreakpoint) {
    font-size: 1.4rem;
    line-height: 2.5rem;
  }
}

@define-mixin InlineHoverSY {
  border-bottom: 1px solid $grayB;
  color: inherit;
  cursor: pointer;

  &:visited,
  &:link {
    color: inherit;
  }

  @media (min-width: $smBreakpoint) {
    &:hover {
      border-color: $skin;
    }
  }
}

@define-mixin TeaserHoverSY {
  border-bottom: 1px solid transparent;
  color: inherit;
  cursor: pointer;

  &:visited,
  &:link {
    color: inherit;
  }

  @media (min-width: $smBreakpoint) {
    &:hover {
      border-color: $skin;
    }
  }
}

@define-mixin SubheaderSY {
  color: $black;
  font-family: $fontBague;
  font-size: 2.2rem;
  font-weight: 700;
  line-height: 2.8rem;

  @media (min-width: $smBreakpoint) {
    font-size: 2.6rem;
    line-height: 3.2rem;
  }
}

/*
 *  Schweizer-IllustrierteSY - Buttons
 *  https://www.figma.com/file/TS9ySl2YVCWAqPuyyeDxZo/si_library_styleguide?node-id=0%3A17876
 */

@define-mixin ButtonBigSY {
  font-family: $fontBague;
  font-size: 1.9rem;
  font-weight: 900;
  line-height: 2.2rem;
}

@define-mixin ButtonSmallSY {
  font-family: $fontBague;
  font-size: 1.4rem;
  line-height: 1.8rem;
}

@define-mixin ButtonBaseSY {
  cursor: pointer;

  font-family: $fontBague;
  font-weight: bold;
  text-align: center;
  text-decoration: none;
}

@define-mixin ButtonBaseBigSY {
  @mixin ButtonBaseSY;
  @mixin ButtonBigSY;
  font-size: 1.8rem;
  height: 54px;
  line-height: 2.2rem;
  padding: 16px 24px;
}

@define-mixin ButtonBaseSmallSY {
  @mixin ButtonBaseSY;
  @mixin ButtonSmallSY;
  font-size: 1.4rem;
  height: 34px;
  line-height: 1.8rem;
  padding: 8px 16px;
}

@define-mixin ButtonPrimarySY {
  background: $gradientBlack;
  border: none;
  border-radius: 4px;
  color: $white;

  &:hover {
    background: $skin;
  }
}

@define-mixin ButtonSecondarySY {
  background-color: $white;
  border: 1px solid $black;
  border-radius: 4px;
  color: $black;

  &:hover {
    background-color: $white;
    border: 1px solid $skin;
    color: $skin;
  }
}

@define-mixin ButtonTertiarySY {
  border: none;
  color: $black;

  &:hover {
    color: $skin;
  }
}

/* Primary Buttons */

@define-mixin ButtonPrimaryBigSY {
  @mixin ButtonPrimarySY;
  @mixin ButtonBaseBigSY;
  
}

@define-mixin ButtonPrimarySmallSY {
  @mixin ButtonPrimarySY;
  @mixin ButtonBaseSmallSY;
}

/* Secondary Buttons */

@define-mixin ButtonSecondaryBigSY {
  @mixin ButtonSecondarySY;
  @mixin ButtonBaseBigSY;
}

@define-mixin ButtonSecondarySmallSY {
  @mixin ButtonSecondarySY;
  @mixin ButtonBaseSmallSY;
}

/* Tertiary Buttons */

@define-mixin ButtonTertiaryBigSY {
  @mixin ButtonTertiarySY;
  @mixin ButtonBaseBigSY;
  
}

@define-mixin ButtonTertiarySmallSY {
  @mixin ButtonTertiarySY;
  @mixin ButtonBaseSmallSY;
}

