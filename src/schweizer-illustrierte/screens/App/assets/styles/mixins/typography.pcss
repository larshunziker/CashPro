/* https://rasch.invisionapp.com/d/main#/console/13936005/392765386/preview */
@define-mixin Meta1 {
  color: $black;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-weight: 400;
  line-height: 2rem;
}

@define-mixin Meta1RedA {
  @mixin Meta1;
  color: $redA;
}

@define-mixin Meta1Bold {
  color: $black;
  font-family: $fontBague;
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 2rem;
}

@define-mixin Meta1BoldRedA {
  @mixin Meta1Bold;
  color: $redA;
}

/* NOT FROM STYLE GUIDE */
