  color: $black;
  font-family: $fontBague;
  font-size: 1.2rem;
  font-weight: 900;
  line-height: 1.4rem;
}

/* NOT FROM STYLE GUIDE */
@define-mixin ZodiacSignsOverlayIconTitle {
  color: $black;
  font-family: $fontBague;
  font-size: 0.9rem;
  font-style: normal;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 0.9rem;
}

@define-mixin Subheader {
  color: $black;
  font-family: $fontBague;
  font-size: 2.2rem;
  font-weight: 700;
  line-height: 2.8rem;

  @media (min-width: $smBreakpoint) {
    font-size: 2.6rem;
    line-height: 3.2rem;
  }
}

@define-mixin LatestChannel {
  color: $black;
  font-family: $fontBague;
  font-size: 1.4rem;
  font-weight: 300;
  line-height: 2rem;
}

@define-mixin AdCaption {
  color: $grayC;
  font-family: $fontBague;
  font-size: 1.1rem;
  font-weight: 200;
  letter-spacing: 0.1px;
  text-transform: uppercase;
}

@define-mixin FormLabelBig {
  color: $black;
  font-family: $fontBague;
  font-size: 1.8rem;
  line-height: 2.2rem;
}

@define-mixin FormLabelBigGrayC {
  @mixin FormLabelBig;
  color: $grayC;
}

@define-mixin FormLabelSmall {
  color: $black;
  font-family: $fontBague;
  font-size: 1.4rem;
  line-height: 1.6rem;
}

@define-mixin FormLabelSmallGrayC {
  @mixin FormLabelSmall;
  color: $grayC;
}

@define-mixin SIIconFiles {
  display: inline;
  font-family: $fontIcons;
  margin-right: 1px;
  vertical-align: top;
}

/*
 *  Schweizer-Illustrierte - Buttons
 *  https://www.figma.com/file/TS9ySl2YVCWAqPuyyeDxZo/si_library_styleguide?node-id=0%3A17876
 */

@define-mixin ButtonBig {
  font-family: $fontBague;
  font-size: 1.9rem;
  font-weight: 900;
  line-height: 2.2rem;
}

@define-mixin ButtonSmall {
  font-family: $fontBague;
  font-size: 1.4rem;
  line-height: 1.8rem;
}

@define-mixin ButtonBase {
  cursor: pointer;

  font-family: $fontBague;
  font-weight: bold;
  text-align: center;
  text-decoration: none;
}

@define-mixin ButtonBaseBig {
  @mixin ButtonBase;
  @mixin ButtonBig;
  font-size: 1.8rem;
  height: 54px;
  line-height: 2.2rem;
  padding: 16px 24px;
}

@define-mixin ButtonBaseSmall {
  @mixin ButtonBase;
  @mixin ButtonSmall;
  font-size: 1.4rem;
  height: 34px;
  line-height: 1.8rem;
  padding: 8px 16px;
}

@define-mixin ButtonPrimary {
  background: $gradientSI;
  border: none;
  border-radius: 4px;
  color: $white;

  &:hover {
    background: $redC;
  }
}

@define-mixin ButtonSecondary {
  background: $white;
  border: 1px solid $redA;
  border-radius: 4px;
  color: $redA;

  &:hover {
    background: $white;
    border: 1px solid $redA;
    color: $redC;
  }
}

@define-mixin ButtonTertiary {
  border: none;
  color: $redA;

  &:hover {
    color: $redC;
  }
}

/* Primary Buttons */

@define-mixin ButtonPrimaryBig {
  @mixin ButtonPrimary;
  @mixin ButtonBaseBig;
}

@define-mixin ButtonPrimarySmall {
  @mixin ButtonPrimary;
  @mixin ButtonBaseSmall;
}

/* Secondary Buttons */

@define-mixin ButtonSecondaryBig {
  @mixin ButtonSecondary;
  @mixin ButtonBaseBig;
}

@define-mixin ButtonSecondarySmall {
  @mixin ButtonSecondary;
  @mixin ButtonBaseSmall;
}

/* Tertiary Buttons */

@define-mixin ButtonTertiaryBig {
  @mixin ButtonTertiary;
  @mixin ButtonBaseBig;
}

@define-mixin ButtonTertiarySmall {
  @mixin ButtonTertiary;
  @mixin ButtonBaseSmall;
}

@define-mixin RichTextLink {
  &:not([href*='schweizer-illustrierte.ch']) {
    &:not([href^='#']) {
      &:not([href^='/']) {
        &:not([href^='mailto:']) {
          &:not([href^='tel:']) {
            &:not([class*='teaser']) {
              &:not([class*='utility-button']) {
                &:not([class*='Icon']) {
                  &::after {
                    @mixin SIIconFiles;
                    content: '\e94d';
                    margin-left: 3px;
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  @media print {
    border-bottom: 0;

    &::after {
      display: none !important; /* stylelint-disable-line */
    }
  }
}
