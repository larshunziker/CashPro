            "anchorId": null,
            "id": "cGFyYWdyYXBoOnRleHQ6MTExMDc1Njo0NzMyMjAw",
            "characterCount": 384,
            "isLastOfGroup": true,
            "header": null,
            "text": "<h3>Sneaker mit Lederanteil</h3>\n\n<p><a onclick=\"window.handleWysiwygLink(event)\" target=\"_self\" data-teaser-align=\"right\" href=\"https://www.schweizer-illustrierte.ch/style/lifestyle/schuhe-regenfest-pimpen-so-gehts\">Stoffschuhe</a> können bedenkenlos in die Trommel gesteckt werden. Sobald sich aber Details aus <a onclick=\"window.handleWysiwygLink(event)\" target=\"_self\" data-teaser-align=\"right\" href=\"https://www.schweizer-illustrierte.ch/style/fashion/weite-lederhosen-sind-das-trend-piece-der-stunde\">Leder</a> daran befinden, ist der Waschgang in der Maschine leider tabu. Leder kann in heissem Wasser schrumpfen und der Schuh sich dadurch verformen. <a onclick=\"window.handleWysiwygLink(event)\" target=\"_self\" data-teaser-align=\"right\" href=\"https://www.schweizer-illustrierte.ch/style/lifestyle/mit-diesen-tipps-bleiben-weisse-sneakers-sauber\">Verschmutzungen</a> lieber mit einem feuchten Tuch und etwas Schuhreiniger von Hand entfernen. Das geht ganz fix, versprochen.</p>\n",
            "styleValue": null,
            "__typename": "TextParagraph"
          },
